<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.temp.biz.mapper.system.SystemPostMapper">
    <sql id="postRespVOBaseQuery">
        select sp.id,
               sp.name,
               sp.sort,
               sp.status,
               sp.remark,
               sp.create_time
        from system_post sp
    </sql>

    <select id="getByName" resultType="com.temp.biz.entity.system.SystemPost">
        SELECT *
        FROM system_post
        WHERE name = #{postName}
          AND delete_flag = 0
    </select>

    <select id="page" resultType="com.temp.biz.domain.vo.system.post.PostResVO">
        <include refid="postRespVOBaseQuery"/>
        where sp.delete_flag = 0
        <if test="request.name != null and request.name != ''">
            and sp.name like concat('%', #{request.name}, '%')
        </if>
        <if test="request.status != null">
            and sp.status = #{request.status.value}
        </if>
    </select>

    <select id="getDetailById" resultType="com.temp.biz.domain.vo.system.post.PostResVO">
        <include refid="postRespVOBaseQuery"/>
        where sp.id = #{postId}
    </select>

    <select id="getSimplePostList" resultType="com.temp.biz.domain.vo.system.post.PostSimpleResVO">
        select sp.id,
               sp.name
        from system_post sp
        where sp.delete_flag = 0
          and sp.status = 0
        order by sp.sort
    </select>
</mapper>