<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.temp.biz.mapper.system.SystemUserPostMapper">
    <select id="getPostByUserId" resultType="com.temp.biz.entity.system.SystemPost">
        select sp.*
        from system_user_post sup
                 left join system_post sp on (sp.delete_flag = 0 and sp.id = sup.post_id)
        where sup.user_id = #{userId}
          and sup.delete_flag = false
    </select>

    <delete id="deleteByUserId">
        delete
        from system_user_post
        where user_id = #{userId};
    </delete>
</mapper>