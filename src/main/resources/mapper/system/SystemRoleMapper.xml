<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.temp.biz.mapper.system.SystemRoleMapper">
    <sql id="RoleResVOBaseQuery">
        select sr.id,
               sr.name,
               sr.code,
               sr.sort,
               sr.data_scope,
               sr.data_scope_dept_ids,
               sr.status,
               sr.remark,
               sr.create_time
        from system_role sr
    </sql>

    <select id="getByName" resultType="com.temp.biz.entity.system.SystemRole">
        SELECT *
        FROM system_role
        WHERE name = #{roleName}
          AND delete_flag = 0
    </select>

    <select id="getByCode" resultType="com.temp.biz.entity.system.SystemRole">
        SELECT *
        FROM system_role
        WHERE code = #{roleCode}
          AND delete_flag = 0
    </select>

    <select id="page" resultType="com.temp.biz.domain.vo.system.role.RoleResVO">
        <include refid="RoleResVOBaseQuery"/>
        where sr.delete_flag = 0
        <if test="request.name != null and request.name != ''">
            and sr.name like concat('%', #{request.name}, '%')
        </if>
        <if test="request.code != null and request.code != ''">
            and sr.code like concat('%', #{request.code}, '%')
        </if>
        <if test="request.status != null">
            and sr.status = #{request.status.value}
        </if>
    </select>

    <select id="getById" resultType="com.temp.biz.domain.vo.system.role.RoleResVO">
        <include refid="RoleResVOBaseQuery"/>
        where sr.id = #{roleId}
    </select>

    <select id="listSimple" resultType="com.temp.biz.domain.vo.system.role.RoleSimpleResVO">
        select id,
               name,
               code
        from system_role
        where delete_flag = 0
    </select>
</mapper>